{
  // 与 check.mjs 的 Markdown 白名单一致。npm run check 会显式传入文件，
  // 这些 glob 供直接调用 markdownlint-cli2 时使用。不包含 circus-paseo 或 .omp。
  "globs": ["../../README.md", "../../AGENTS.md", "../**/*.md"],
  "ignores": ["node_modules/**", "../qa/node_modules/**"],
  "config": {
    "default": true,
    // 中文散文和长链接不按 80 列折行。
    "MD013": false,
    // 允许 HTML 注释；链接检查不解析 HTML 属性。
    "MD033": false,
    // 列表项整行加粗是正文强调，不是标题。
    "MD036": false,
    // 同名标题只在同一父节内冲突，交付文档会重复小节名。
    "MD024": { "siblings_only": true },
    // 标题片段由 check.mjs 用 github-slugger 检查。关闭 MD053/MD054，避免强制链接风格。
    "MD051": false,
    "MD053": false,
    "MD054": false
  }
}
